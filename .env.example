# ==============================================================================
# IMPACTEERS DMS — LEGAL ASSISTANT AI CONFIGURATION (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`:
#    cp .env.example .env
# 2. Add your AI API key and model below.
# 3. The server will securely load these settings. The API key is NEVER sent to the browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Provider Selection
# Options:
# - 'openai_compatible' (For OpenAI, OpenRouter, Groq, Mistral, Together, DeepSeek, Google Gemini OpenAI endpoint)
# - 'gemini'            (For Google Gemini native v1beta API)
# - 'ollama'            (For local offline Ollama running on http://127.0.0.1:11434)
# ------------------------------------------------------------------------------
AI_PROVIDER=openai_compatible

# ------------------------------------------------------------------------------
# 2. API Key (REQUIRED for Cloud AI Providers)
# Replace with your actual secret API key.
# ------------------------------------------------------------------------------
AI_API_KEY=your_secret_api_key_here

# ------------------------------------------------------------------------------
# 3. AI Model Name
# Examples:
# - OpenAI       : gpt-4o, gpt-4o-mini
# - Google Gemini: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
# - Groq         : llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# - OpenRouter   : meta-llama/llama-3.3-70b-instruct, google/gemini-2.0-flash-exp:free, deepseek/deepseek-chat
# - Ollama       : llama3.2, mistral, qwen2.5, deepseek-r1
# ------------------------------------------------------------------------------
AI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. API Base URL (For OpenAI-compatible providers)
# Examples:
# - OpenAI       : https://api.openai.com/v1
# - OpenRouter   : https://openrouter.ai/api/v1
# - Groq         : https://api.groq.com/openai/v1
# - Gemini OpenAI: https://generativelanguage.googleapis.com/v1beta/openai/
# - Ollama Local : http://127.0.0.1:11434/api
# ------------------------------------------------------------------------------
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------------------------------------------
# 5. Security & Rate Limiting Controls
# ------------------------------------------------------------------------------
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2
AI_RATE_LIMIT_PER_MINUTE=60
AI_MAX_INPUT_CHARS=50000
